#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("../../../soc_perf.gni")

##############################fuzztest##########################################
ohos_fuzztest("SocPerfConfigFuzzTest") {
  module_out_path = "soc_perf/soc_perf"
  fuzz_config_file = "${socperf_test}/fuzztest/socperf_config_fuzzer"

  include_dirs = [
    "${socperf_interfaces}/inner_api/socperf_client/include",
    "${socperf_common}/include",
    "${socperf_services}/core/include",
    "${socperf_services}/dfx/include",
    "${socperf_test}/fuzztest/include",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [
    "socperf_config_fuzzer.cpp",
  ]

  deps = [
    "${socperf_services}:socperf_server_static",
  ]

  external_deps = [
    "cJSON:cjson_static",
    "c_utils:utils",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "ipc:ipc_single",
    "libxml2:libxml2",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":SocPerfConfigFuzzTest",
  ]
}
###############################################################################
