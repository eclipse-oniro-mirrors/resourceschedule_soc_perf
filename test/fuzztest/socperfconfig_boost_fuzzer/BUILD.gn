#####################hydra-fuzz###################
import("../../../soc_perf.gni")
import("//build/config/features.gni")
import("//build/test.gni")

##############################fuzztest##########################################
config("socperf_config_boost_private_config") {
  include_dirs = [
    "${socperf_common}/include",
    "${socperf_interfaces}/inner_api/socperf_client/include",
    "${socperf_services}/core/include",
    "${socperf_services}/server/include",
    "${socperf_test}/fuzztest/include",
  ]
}

ohos_fuzztest("SocperfConfigBoostFuzzTest") {
  module_out_path = "soc_perf/soc_perf"
  fuzz_config_file = "${socperf_test}/fuzztest/socperfconfig_boost_fuzzer"
  configs = [ ":socperf_config_boost_private_config" ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Dprivate=public",
    "-Dprotected=public",
  ]
  sources = [
    "socperfconfig_boost_fuzzer.cpp",
  ]

  deps = [ "${socperf_services}:socperf_server_static" ]

  external_deps = [
    "c_utils:utils",
    "ffrt:libffrt",
    "hilog:libhilog",
    "libxml2:libxml2",
  ]
}
###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":SocperfConfigBoostFuzzTest",
  ]
}
###############################################################################
